# Required: long random string that signs login tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# MongoDB connection (defaults shown)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=airrunner

# Email delivery for sign-up and password-reset codes.
# Leave blank for local development and codes are printed to the server console instead.
# For Gmail, use an App Password, not your account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
